  "networks": [
    {
      "name": "lab201-wan",
      "kind": "uplink",
      "note": "Internet-facing network. gw-201 uses it for its uplink, and every VM has a build NIC on it for package installs. Remove the build NICs when the build is done."
    },
    {
      "name": "lab201-oob",
      "kind": "uplink",
      "note": "Segment 0. Connect its uplink to the switches' management ports."
    },
    {
      "name": "lab201-t1",
      "kind": "trunk",
      "note": "Trunk T1 to sw-648f-1. Carries VLANs 2, 3, 4, 5, 6, 7, 8 and links L1 and L2."
    },
    {
      "name": "lab201-t2",
      "kind": "trunk",
      "note": "Trunk T2 to sw-2048f-1. Carries links L3 and L4. gw-201 bridges T1 and T2 so one set of gateway addresses serves both switches."
    },
    {
      "name": "lab201-mcast",
      "kind": "internal",
      "note": "Segment 12 behind rtr-peer-1. No uplink."
    }
  ],
