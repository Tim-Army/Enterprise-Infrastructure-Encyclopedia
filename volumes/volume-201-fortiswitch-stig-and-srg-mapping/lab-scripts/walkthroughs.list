# Lab chapters that the Lab Builder puts in its zip, in walkthrough order.
# Each line is CHAPTER-FILE = SHORT-NAME. The site build publishes each chapter
# from this volume's chapters folder to lab-scripts/walkthroughs/CHAPTER-FILE.
# The Lab Builder stores it in the zip as walkthroughs/SHORT-NAME, to keep the
# paths short for Windows. scripts/python/sync_lab_builder.py copies this list
# and the lab headings of the chapters into the Lab Builder page.
999-shared-lab-infrastructure.md = 999-shared-lab.md
04-layer-2-switch-srg-requirement-labs.md = 04-layer-2-labs.md
05-network-device-management-srg-requirement-labs.md = 05-management-labs.md
06-router-srg-requirement-labs.md = 06-router-labs.md
07-aaa-services-srg-requirement-labs.md = 07-aaa-labs.md
08-opengear-im7216-console-server-and-optional-console-lab.md = 08-console-lab.md
