{
  "description": "Linux, Windows, and other flavors the lab scripts know. status ready means a script can build it; experimental means the generated files are checked but no machine has been built from them. iso marks flavors that install from an ISO you supply (Windows, Linux Mint, Tiny Core) instead of a cloud image; manual means a person still runs part of the install. roles rates each machine type: y works, x needs extra steps, n is not offered. The ratings are proposals that need a test build.",
  "default": "ubuntu-24.04",
  "role_keys": [
    "gateway",
    "services",
    "certificate authority",
    "DHCP server",
    "administrator workstation",
    "routing peer",
    "multicast source",
    "static host",
    "spoofing and flooding test host"
  ],
  "families": {
    "apt": {
      "install": "apt",
      "admin_group": "sudo",
      "map": { "sflowtool": null }
    },
    "dnf": {
      "install": "dnf",
      "admin_group": "wheel",
      "services": { "freeradius": "radiusd", "rsyslog": "rsyslog", "chrony": "chronyd", "tftpd-hpa": "tftp.socket" },
      "service_prep": { "freeradius": "cd /etc/raddb/certs && ./bootstrap && chgrp -R radiusd /etc/raddb/certs && chmod -R g+rX /etc/raddb/certs" },
      "map": {
        "snmp": "net-snmp-utils",
        "snmptrapd": "net-snmp",
        "tftpd-hpa": "tftp-server",
        "kea-dhcp4-server": "kea",
        "openssh-client": "openssh-clients",
        "arping": "iputils",
        "sflowtool": null,
        "dhcpdump": null,
        "yersinia": null
      },
      "epel_packages": [
        "nfdump",
        "smcroute",
        "hping3",
        "python3-scapy",
        "frr"
      ]
    },
    "mint": {
      "install": "apt",
      "admin_group": "sudo",
      "map": {}
    },
    "tce": {
      "install": "tce",
      "admin_group": "staff",
      "map": {
        "arping": "iputils",
        "smcroute": null,
        "qemu-guest-agent": null,
        "open-vm-tools": "open-vm-tools"
      }
    },
    "windows": {
      "install": "windows",
      "admin_group": "Administrators",
      "map": {}
    }
  },
